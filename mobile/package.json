{
  "name": "uvs-chatbox-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Uv's Chat Box — iOS companion. Sends VRChat chatbox OSC over WiFi to a standalone headset (Quest/Pico).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.5",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
